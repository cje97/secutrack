            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "pm.test('Rôle USER à l\\'inscription', () => pm.expect(pm.response.json().utilisateur.role).to.eql('USER'));"
                ]
