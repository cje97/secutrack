{
  "info": {
    "_postman_id": "cf700d49-6986-4fca-9864-f6a8b22321f8",
    "name": "SecuTrack API",
    "description": "Collection de test de l'API SecuTrack.\n\nOrdre conseillé : 1. Authentification > Login ADMIN, puis les dossiers dans l'ordre. Le jeton est enregistré automatiquement dans la variable {{token}}.\n\nLancer toute la collection : bouton Run (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Se connecte avec le compte administrateur de démo et enregistre le jeton dans la variable {{token}}, utilisée ensuite par toutes les requêtes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courriel\": \"admin@secutrack.local\",\n  \"motDePasse\": \"Demo1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "const corps = pm.response.json();",
                  "pm.collectionVariables.set('token', corps.token);",
                  "pm.test('Rôle ADMIN', () => pm.expect(corps.utilisateur.role).to.eql('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
